{
    "folders": [
        {
            "path": ".."
        }
    ],
    "settings": {
        "files.associations": {
            "iostream": "cpp",
            "string": "cpp"
        },

        // ⬇️ Hide all .o files
		"files.exclude": {
			"**/*.o": true,
			"**/**.o": true,
			"*.o": true
		},
		

        // (optional) also prevent the file watcher from scanning them
        "files.watcherExclude": {
             "**/*.o": true
         }
    }
}
